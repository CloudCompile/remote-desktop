[Unit]
Description=Remote desktop control server (port 8090)
After=network.target remote-session.service
Wants=remote-session.service

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/remote-desktop
Environment=RD_USER=YOUR_USER
Environment=RD_DISPLAY=:1
Environment=VNC_HOST=127.0.0.1
Environment=VNC_PORT=5901
ExecStart=/usr/bin/python3 /opt/remote-desktop/control.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
